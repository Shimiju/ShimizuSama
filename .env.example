# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BOT_OWNER_ID=

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:***@localhost:5432/shimizu

# Dashboard / OAuth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
DASHBOARD_URL=http://localhost:5173
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback
BIND_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Lavalink
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CHANGE_ME
LAVALINK_SECURE=false

# Audio Proxy (jembatan yt-dlp -> Lavalink)
AUDIO_PROXY_PORT=4001
# URL proxy dari sudut pandang Lavalink (Lavalink di Docker Desktop: host.docker.internal)
AUDIO_PROXY_LAVALINK_URL=http://host.docker.internal:4001
# Path kustom (opsional; default relatif ke folder project):
# YTDLP_PATH=./lavalink/yt-dlp/yt-dlp
# YTDLP_NODE_PATH=./lavalink/node/bin/node
# YTDLP_COOKIES_PATH=./lavalink/yt-dlp/cookies.txt

# Runtime
NODE_ENV=development